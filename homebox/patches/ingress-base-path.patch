diff --git a/frontend/lib/ingress.ts b/frontend/lib/ingress.ts
new file mode 100644
index 0000000..92a1ab1
--- /dev/null
+++ b/frontend/lib/ingress.ts
@@ -0,0 +1,29 @@
+// Home Assistant Ingress serves this app from a path it only settles on at
+// request time, and NGINX writes that path into the page on the way past. The
+// Ingress plugin hands it to this module once, at startup, and everything that
+// builds an address the router never sees reads it back from here.
+//
+// It lives in a plain module rather than behind "useRuntimeConfig()" so that
+// the table cell renderers and the other call sites outside a component setup
+// can reach it too, where there is no Nuxt instance to ask.
+
+let subPath = "";
+
+export function setSubPath(value: string) {
+  subPath = value;
+}
+
+export function getSubPath(): string {
+  return subPath;
+}
+
+// The other direction: takes an address out of the browser's location bar and
+// gives back the one this app knows itself by. Anything handed to the router
+// has to be stripped first, because the router puts the prefix back on.
+export function stripSubPath(path: string): string {
+  if (subPath && path.startsWith(subPath)) {
+    return path.slice(subPath.length) || "/";
+  }
+
+  return path;
+}
