diff --git a/frontend/plugins/01.ingress.client.ts b/frontend/plugins/01.ingress.client.ts
new file mode 100644
index 0000000..bcf685e
--- /dev/null
+++ b/frontend/plugins/01.ingress.client.ts
@@ -0,0 +1,28 @@
+import { overrideParts } from "~~/lib/api/base/urls";
+import { setSubPath } from "~~/lib/ingress";
+
+// Homebox addresses its API from the site root. Under Ingress the site root
+// belongs to Home Assistant rather than to Homebox, so those calls would never
+// arrive. NGINX writes the path Ingress handed out into SUB_PATH per request,
+// and this is what reads it back.
+//
+// Every REST call and every attachment URL is built by "route()" out of the
+// prefix held in lib/api/base/urls, so moving that one value moves the whole
+// API surface with it. The numeric filename and the "pre" enforcement are what
+// put this ahead of the plugins that go on to use it.
+export default defineNuxtPlugin({
+  name: "ingress-sub-path",
+  enforce: "pre",
+  setup() {
+    const subPath = useRuntimeConfig().public.SUB_PATH || "";
+    if (!subPath) {
+      return;
+    }
+
+    setSubPath(subPath);
+
+    // The host here is the placeholder "route()" strips back out of its result.
+    // Only the prefix carries anything.
+    overrideParts("http://localhost.com", `${subPath}/api/v1`);
+  },
+});
